# Copy to .env and fill in for local development. Never commit real secrets — see
# docs/DATA_POLICY.md and CLAUDE.md "Absolute rules".

DATABASE_URL="postgresql://user:password@localhost:5432/market_os?schema=public"

# Data source API keys (all free-tier; obtaining/entering real values is a Human Gate for
# anything requiring payment info). Adapters fall back to fixtures when unset — see
# docs/ARCHITECTURE.md "Data sources".
FRED_API_KEY=
ECOS_API_KEY=
DART_API_KEY=

# SEC EDGAR requires no API key, only a descriptive User-Agent identifying the requester
# (SEC fair-access policy) — e.g. "Market OS you@example.com".
EDGAR_USER_AGENT=
