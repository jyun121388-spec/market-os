// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// M01/M02 groundwork: source registry, normalized observations, and the
// Claim Ledger (see docs/ARCHITECTURE.md "Claim Ledger" and
// "Hallucination-resistant pipeline"). Adapters write raw + normalized data;
// nothing here is written by an LLM directly.
// ---------------------------------------------------------------------------

enum SourceTier {
  TIER_S // government / central bank / exchange / official filings / stats agencies
  TIER_A // major wire services / high-trust primary reporting
  TIER_B // major financial press
  TIER_C // general press
  TIER_D // social / community
}

model Source {
  id        String     @id @default(cuid())
  code      String     @unique // e.g. "FRED", "ECOS", "DART", "SEC_EDGAR"
  name      String
  tier      SourceTier
  homepage  String?
  createdAt DateTime   @default(now())

  series                 Series[]
  observations           Observation[]
  claims                 Claim[]
  filings                Filing[]
  eventMentions          EventMention[]
  financialFacts         FinancialFact[]
  etfs                   Etf[]
  realEstateTransactions RealEstateTransaction[]

  @@map("sources")
}

// A tracked economic/market variable (e.g. "US 10Y Treasury Yield", "UST10Y").
model Series {
  id         String   @id @default(cuid())
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id])
  externalId String // the identifier used by the source (e.g. FRED series id "DGS10")
  name       String
  unit       String // e.g. "percent", "index", "USD", "KRW_per_USD"
  frequency  String // e.g. "daily", "weekly", "monthly", "quarterly"
  createdAt  DateTime @default(now())

  observations Observation[]

  @@unique([sourceId, externalId])
  @@map("series")
}

// A single normalized data point. Raw source payload is preserved in `raw`
// for auditability; normalized fields are what the app reads.
model Observation {
  id              String    @id @default(cuid())
  seriesId        String
  series          Series    @relation(fields: [seriesId], references: [id])
  sourceId        String
  source          Source    @relation(fields: [sourceId], references: [id])
  observationDate DateTime // the date/period the value describes (not when it was released)
  releaseDate     DateTime? // when the source published this value, if known
  value           Decimal   @db.Decimal(20, 6)
  isPreliminary   Boolean   @default(false)
  isRevision      Boolean   @default(false)
  revisionOf      String? // id of the Observation this revises, if any
  retrievedAt     DateTime  @default(now())
  raw             Json // untouched source payload for this observation
  createdAt       DateTime  @default(now())

  conflicts DataConflict[]

  @@unique([seriesId, observationDate, isRevision, revisionOf])
  @@index([seriesId, observationDate])
  @@map("observations")
}

// Recorded when two sources disagree on a value instead of silently picking one.
// See docs/ARCHITECTURE.md "Data conflict handling".
model DataConflict {
  id              String      @id @default(cuid())
  observationId   String
  observation     Observation @relation(fields: [observationId], references: [id])
  conflictingWith Json // { sourceCode, value, observationDate, retrievedAt } for the other source
  officialSource  String? // source code considered authoritative, if determinable
  resolved        Boolean     @default(false)
  resolutionNote  String?
  createdAt       DateTime    @default(now())

  @@map("data_conflicts")
}

// ---------------------------------------------------------------------------
// M05 groundwork: corporate disclosures/filings (OpenDART, later SEC EDGAR).
// Structurally different from Series/Observation — a filing is a discrete
// document/event, not a time-series data point.
// ---------------------------------------------------------------------------

model Filing {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id])
  corpCode    String // source-specific company identifier (DART corp_code, CIK for EDGAR, ...)
  corpName    String
  stockCode   String? // exchange ticker/code, if applicable
  reportName  String // e.g. "사업보고서 (2026.06)"
  receiptNo   String // source-specific unique receipt/accession number (DART rcept_no)
  receiptDate DateTime // date DART/EDGAR received the filing (not a fiscal period)
  remark      String? // source-specific flag, e.g. DART's `rm` (정정/첨부 등)
  retrievedAt DateTime @default(now())
  raw         Json // untouched source payload for this filing
  createdAt   DateTime @default(now())

  @@unique([sourceId, receiptNo])
  @@index([sourceId, corpCode])
  @@map("filings")
}

// ---------------------------------------------------------------------------
// M15 groundwork: Company X-Ray — structured financial-statement facts (e.g.
// SEC EDGAR's XBRL companyfacts API). Distinct from Filing: a Filing is a
// document/event; a FinancialFact is a single tagged numeric value from
// inside one (e.g. "Revenues" = $383,285,000,000 for FY2023, accession
// 0000320193-23-000106). See docs/DECISIONS.md for scope (structured XBRL
// facts only — filing *text*, e.g. risk factors, is out of scope here).
// ---------------------------------------------------------------------------

model FinancialFact {
  id              String    @id @default(cuid())
  sourceId        String
  source          Source    @relation(fields: [sourceId], references: [id])
  corpCode        String // CIK for EDGAR, DART corp_code later
  taxonomy        String // e.g. "us-gaap"
  concept         String // e.g. "Revenues", "NetIncomeLoss"
  unit            String // e.g. "USD"
  periodStart     DateTime? // null for instant (point-in-time) concepts like Assets
  periodEnd       DateTime
  fiscalYear      Int
  fiscalPeriod    String // "Q1" | "Q2" | "Q3" | "FY"
  form            String // e.g. "10-K", "10-Q"
  accessionNumber String // links back to the Filing.receiptNo this value came from
  filedDate       DateTime
  value           Decimal   @db.Decimal(24, 4)
  retrievedAt     DateTime  @default(now())
  raw             Json // untouched source payload for this fact
  createdAt       DateTime  @default(now())

  @@unique([sourceId, corpCode, concept, unit, periodEnd, accessionNumber])
  @@index([sourceId, corpCode, concept])
  @@map("financial_facts")
}

// ---------------------------------------------------------------------------
// M17 groundwork: ETF X-Ray. Exposure facts only — index, expense ratio,
// holdings, sector/country/currency exposure. Deliberately NO score/rating/
// suitability field anywhere in this model: docs/LEGAL_GUARDRAILS.md hard-
// prohibits a "buy fitness score" or investment-recommendation output, and
// the schema itself should make that impossible to add by accident (same
// enforce-via-schema approach as CausalEdge.counterexamples, M13). No
// ingestion adapter ships with this milestone — see docs/DECISIONS.md: the
// candidate free holdings sources (ssga.com, ishares.com) are egress-blocked
// in this dev environment, and issuer holdings files are not a stable,
// well-documented public API the way FRED/ECOS/DART/EDGAR are.
// ---------------------------------------------------------------------------

model Etf {
  id           String   @id @default(cuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id])
  ticker       String
  name         String
  issuer       String
  trackedIndex String? // the index this ETF tracks, if applicable
  expenseRatio Decimal? @db.Decimal(6, 4) // e.g. 0.0945 = 0.0945%
  asOfDate     DateTime // date this snapshot's facts (expense ratio, holdings) are as of
  retrievedAt  DateTime @default(now())
  raw          Json
  createdAt    DateTime @default(now())

  holdings EtfHolding[]

  @@unique([sourceId, ticker, asOfDate])
  @@map("etfs")
}

model EtfHolding {
  id            String   @id @default(cuid())
  etfId         String
  etf           Etf      @relation(fields: [etfId], references: [id])
  holdingName   String
  holdingTicker String?
  weightPct     Decimal  @db.Decimal(8, 5) // percent of fund, e.g. 7.12345
  sector        String?
  country       String?
  currency      String?
  createdAt     DateTime @default(now())

  @@index([etfId])
  @@map("etf_holdings")
}

// ---------------------------------------------------------------------------
// M18 groundwork: Real Estate Intelligence (Korea). Individual transaction
// records — 실거래가 (actual transaction price) data shape, matching MOLIT's
// well-known public dataset. No ingestion adapter ships with this milestone
// (data.go.kr is egress-blocked in this dev environment) — see
// docs/DECISIONS.md. Schema + a deterministic median-based analysis module
// are tested against seeded fixture data.
// ---------------------------------------------------------------------------

enum RealEstateDealType {
  SALE // 매매
  JEONSE // 전세
  WOLSE // 월세
}

model RealEstateTransaction {
  id           String             @id @default(cuid())
  sourceId     String
  source       Source             @relation(fields: [sourceId], references: [id])
  region       String // e.g. "서울특별시 강남구" — dong-level or gu-level, source-dependent
  propertyType String // e.g. "아파트", "오피스텔" — kept as source-provided text, not an enum
  dealType     RealEstateDealType
  areaSqm      Decimal            @db.Decimal(8, 2)
  price        Decimal            @db.Decimal(16, 2) // KRW 만원 (10,000 KRW) units, per MOLIT convention
  dealDate     DateTime
  buildYear    Int?
  floor        Int?
  retrievedAt  DateTime           @default(now())
  raw          Json
  createdAt    DateTime           @default(now())

  @@index([sourceId, region, dealType, dealDate])
  @@map("real_estate_transactions")
}

// ---------------------------------------------------------------------------
// M07 groundwork: Event Intelligence. Many news/metadata mentions of the same
// real-world event are clustered into one Event. Clustering is a deterministic
// keyword/time-window heuristic (src/server/domain/eventClustering.ts) — no
// LLM is used to decide event membership. News is a detection sensor: only
// metadata (title/url/timestamp/source) is stored, never full article text
// (docs/DATA_POLICY.md "News policy").
// ---------------------------------------------------------------------------

model Event {
  id                String   @id @default(cuid())
  topic             String // representative headline, taken from the first mention
  keywords          String[] // deterministic keyword set used for clustering new mentions
  firstSeenAt       DateTime
  latestUpdateAt    DateTime
  mentionCount      Int      @default(1)
  distinctTierCount Int      @default(1) // how many distinct source tiers have mentioned this
  createdAt         DateTime @default(now())

  mentions EventMention[]

  @@index([latestUpdateAt])
  @@map("events")
}

model EventMention {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  sourceId    String?
  source      Source?  @relation(fields: [sourceId], references: [id])
  title       String
  url         String   @unique // dedupes the exact same article being ingested twice
  publishedAt DateTime
  retrievedAt DateTime @default(now())
  raw         Json // source metadata only — never full article body, see docs/DATA_POLICY.md
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@map("event_mentions")
}

// ---------------------------------------------------------------------------
// M13 groundwork: Economic Causal Graph. Transmission-path edges between
// economic variables, always confidence-qualified and never presented as
// confirmed causation from correlation alone (docs/PRODUCT_SPEC.md "Economic
// Causal Graph"). `counterexamples` is required, not optional — an edge
// without an acknowledged limitation is not allowed into the schema, which
// forces epistemic honesty structurally rather than relying on every future
// caller to remember to add one.
// ---------------------------------------------------------------------------

enum CausalDirection {
  POSITIVE // an increase in `fromVariable` tends to increase `toVariable`
  NEGATIVE // an increase in `fromVariable` tends to decrease `toVariable`
  AMBIGUOUS // direction is context-dependent; see `conditions`
}

enum CausalConfidence {
  LOW
  MEDIUM
  HIGH
}

model CausalEdge {
  id              String           @id @default(cuid())
  fromVariable    String // free-text variable/event name, e.g. "Oil price (WTI)"
  toVariable      String // e.g. "Headline CPI inflation"
  direction       CausalDirection
  confidence      CausalConfidence // deliberately an enum, not a fabricated precise float
  mechanism       String // the transmission mechanism in plain language
  evidence        String // why this is believed — established literature/precedent, not a citation-shaped guess
  lag             String // descriptive, e.g. "1-2 quarters" — not a fabricated precise number
  conditions      String? // when this relationship holds or is stronger/weaker
  counterexamples String // REQUIRED: at least one known limitation, exception, or counterexample
  createdAt       DateTime         @default(now())

  @@index([fromVariable])
  @@index([toVariable])
  @@map("causal_edges")
}

enum ClaimType {
  FACT
  CALCULATION
  INFERENCE
}

// The Claim Ledger: every material AI-authored (or derived) statement shown
// to a user is backed by one of these rows. A FACT-typed claim with no
// source must never render as fact — see docs/ARCHITECTURE.md.
model Claim {
  id              String    @id @default(cuid())
  claimText       String
  claimType       ClaimType
  sourceId        String?
  source          Source?   @relation(fields: [sourceId], references: [id])
  sourceUrl       String?
  sourceTimestamp DateTime?
  retrievedAt     DateTime?
  evidence        Json? // supporting data: observation ids, calculation inputs, etc.
  confidence      Float? // 0..1, required for INFERENCE claims
  conflictStatus  String? // "none" | "DATA_CONFLICT" | ...
  generatedAt     DateTime  @default(now())

  @@index([claimType])
  @@map("claims")
}
